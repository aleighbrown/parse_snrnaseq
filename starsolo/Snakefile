# =============================================================================
# STARsolo re-alignment of split-pipe's called cells, for splicing analysis.
#
# The split-pipe run deleted its BAMs. Rather than rerun split-pipe, this
# workflow keeps only the reads from cells split-pipe already called and aligns
# those with STARsolo:
#
#   split-pipe cell_metadata.csv ─► whitelist: one 24-nt barcode per called cell
#   fq2 (sample) ─► read_layout.json: where the UMI and bc1/bc2/bc3 sit
#   fq1 + fq2 ─► extract: called-cell pairs only, R2 rewritten as cb + UMI
#        └─► validation against split-pipe's per-cell mread_count
#   GENCODE v42 FASTA + GTF ─► STAR index (shared lab resource, built once)
#   first 2M reads ─► strand test: --soloStrand Forward vs Reverse
#   R1 ─► STAR pass 1 ─► novel junctions pooled over ALL sublibraries
#   R1 + R2 ─► STARsolo pass 2 ─► sorted BAM (CB/UB) + Gene/GeneFull/SJ matrices
#        └─► target `split`:    per-sublibrary BAM per donor x sort (sinto)
#        └─► target `bams`:     those merged over sublibraries, one per group
#        └─► target `junctions`: SJ matrices summed into junction x group counts
#
# Run from THIS directory (starsolo/):
#   snakemake -n                      dry run
#   source submit.sh                  pilot (rule all)
#   source submit.sh layout           barcode layout only (minutes)
#   source submit.sh reference        STAR index only
#   source submit.sh splicing         merged donor x sort BAMs + junction matrix
# =============================================================================
import os
import re
import shlex

import pandas as pd
from snakemake.exceptions import WorkflowError

configfile: "config/config.yaml"

RESULTS = config["results_dir"].rstrip("/")
TMP_ROOT = (config.get("tmp_dir") or RESULTS + "/tmp").rstrip("/")
SCRIPTS = os.path.join(workflow.basedir, "scripts")
REF = config["reference"]
REF_DIR = REF["dir"].rstrip("/")
STAR = config["star"]
BC = config["parse_barcodes"]
SPLIT = config["split"]
# Optional: restrict the whitelist to QC-passed / annotated cells.
SUBSET = config["cells"].get("subset") or {}
LAYOUT = BC.get("layout") or {}

# --- tools: no conda ---------------------------------------------------------
# The cluster's conda can't solve these envs (old glibc), so every job runs on
# tools that already exist there: python/pandas/numpy/pigz/sinto from
# tools.bin_dirs, STAR from one fixed binary. samtools (1.9 is fine: only
# `index -@` and `sort -@ -o` are used) comes from bin_dirs or your PATH.
TOOLS = config.get("tools") or {}
_bin_dirs = [str(d).rstrip("/") for d in (TOOLS.get("bin_dirs") or [])]
_star_bin = str(TOOLS.get("star") or "")
_star_want = str(TOOLS.get("star_version") or "")
# No f-strings here: Snakemake 7's parser pads them with spaces on Python 3.12.
shell.prefix(
    "set -euo pipefail; "
    + ("export PATH=" + shlex.quote(":".join(_bin_dirs)) + ':"$PATH"; ' if _bin_dirs else "")
    + "STAR_BIN=" + shlex.quote(_star_bin) + "; "
    + "STAR_WANT=" + shlex.quote(_star_want) + "; "
)

# Prepended to every rule that runs STAR: fail early, and loudly, if the binary
# is missing or is not the version the reference was built with.
CHECK_STAR = r"""
if [ -z "$STAR_BIN" ] || [ ! -x "$STAR_BIN" ]; then
    echo "tools.star in config/config.yaml is unset or not executable: '$STAR_BIN'" >&2
    exit 1
fi
if [ -n "$STAR_WANT" ] && [ "$("$STAR_BIN" --version)" != "$STAR_WANT" ]; then
    echo "STAR at $STAR_BIN is $("$STAR_BIN" --version), config says tools.star_version=$STAR_WANT" >&2
    exit 1
fi
"""

subs = (
    pd.read_csv(config["sublibraries"], sep="\t", comment="#", dtype=str)
    .fillna("")
    .set_index("sublibrary", drop=False)
)
SUBLIBS = subs.index.tolist()

wildcard_constraints:
    sublib="|".join(re.escape(s) for s in SUBLIBS),
    # group_table.py makes group names filesystem-safe: donor__sort.
    group=r"[A-Za-z0-9._-]+__[A-Za-z0-9._-]+",

WL = RESULTS + "/whitelist/{sublib}"
EX = RESULTS + "/extract/{sublib}"
SOLO = RESULTS + "/solo/{sublib}"


# --- helpers -----------------------------------------------------------------
def fastq(col):
    def f(wc):
        p = subs.loc[wc.sublib, col]
        return ancient(p if os.path.isabs(p) else os.path.join(config["fastq_dir"], p))
    return f


def as_bool(v):
    """YAML false, or 'false'/'no'/'0' as given via --config."""
    return str(v).strip().lower() not in ("false", "no", "0", "none", "null", "")


def barcode_table(key):
    """Input function, so an unset table only fails the rules that need it
    (the reference can be built before the tables are found)."""
    def f(wc):
        path = BC.get(key)
        if not path or str(path).strip().lower() in ("null", "none"):
            raise WorkflowError(
                f"parse_barcodes.{key} is not set in config/config.yaml.\n"
                "Point bc1/bc2/bc3 at split-pipe's barcode CSVs -- see README.md, "
                "'Finding the barcode tables'."
            )
        return ancient(path)
    return f


def nthreads(rule_name):
    """Must equal the rule's '-pe smp N' in config/cluster.yaml."""
    t = config["threads"]
    return t.get(rule_name, t["default"])


def opt(v):
    """Layout override for the CLI: -1 means auto-detect."""
    return -1 if v is None else int(v)


BC_INPUTS = dict(bc1=barcode_table("bc1"), bc2=barcode_table("bc2"), bc3=barcode_table("bc3"))


def groups_kept(wc=None):
    """Group names from the checkpoint -- known only after group_table has run."""
    path = checkpoints.group_table.get().output.groups
    table = pd.read_csv(path, sep="\t", dtype=str)
    return table["group"].tolist()


def group_bams(wc=None):
    return [RESULTS + "/groups/" + g + ".bam.bai" for g in groups_kept()]

# A reference that already exists is used as-is and has NO rule -- so no run
# of this workflow can ever decide to rebuild (and first delete) a shared index.
REF_BUILT = os.path.exists(os.path.join(REF_DIR, "SA")) and os.path.exists(
    os.path.join(REF_DIR, "genomeParameters.txt")
)


# --- targets -----------------------------------------------------------------
localrules: all, tools, reference, layout, extract, strand, split, bams, junctions, splicing

rule all:
    input:
        expand(EX + "/validation/summary.txt", sublib=SUBLIBS),
        expand(SOLO + "/Aligned.sortedByCoord.out.bam.bai", sublib=SUBLIBS),

rule reference:
    input:
        REF_DIR,

rule layout:
    input:
        expand(EX + "/read_layout.json", sublib=SUBLIBS),

rule extract:
    input:
        expand(EX + "/validation/summary.txt", sublib=SUBLIBS),

rule strand:
    input:
        expand(RESULTS + "/strand/{sublib}/strand.txt", sublib=SUBLIBS),

rule split:
    input:
        expand(RESULTS + "/split/{sublib}/.split.done", sublib=SUBLIBS),

# Per donor x sort, merged over all 16 sublibraries: a BAM for regtools /
# leafcutter / MAJIQ / IGV, and the junction count matrix.
rule bams:
    input:
        group_bams,

rule junctions:
    input:
        RESULTS + "/junctions/sj_counts.by_group.tsv.gz",

rule splicing:
    input:
        group_bams,
        RESULTS + "/junctions/sj_counts.by_group.tsv.gz",

# `source submit.sh tools`: runs on the login node in seconds and fails if any
# tool the jobs need is missing. Never cached -- no output file.
rule tools:
    shell:
        r"""
        """ + CHECK_STAR + r"""
        echo "STAR:    $STAR_BIN ($("$STAR_BIN" --version))"
        echo "python:  $(command -v python) ($(python --version 2>&1))"
        python -c 'import pandas, numpy; print("pandas", pandas.__version__, "| numpy", numpy.__version__)'
        echo "samtools: $(command -v samtools) ($(samtools --version | head -n1))"
        # `samtools index -@` is the newest option used; fail if this build lacks it.
        # (Usage text captured first: bare `samtools index` exits non-zero.)
        index_usage=$(samtools index 2>&1 || true)
        grep -q -- '-@' <<< "$index_usage" || {{ echo "samtools index has no -@ option" >&2; exit 1; }}
        echo "sinto:   $(command -v sinto || echo 'MISSING -- needed only for the split target')"
        echo "pigz:    $(command -v pigz || echo 'MISSING -- extraction falls back to gzip, slower')"
        """


# --- whitelist ---------------------------------------------------------------
rule make_whitelist:
    input:
        cells=ancient(config["cells"]["file"]),
        subset=ancient(SUBSET["file"]) if SUBSET.get("file") else [],
        **BC_INPUTS,
    output:
        cells=WL + "/cells.tsv",
        whitelist=WL + "/whitelist.txt",
    params:
        scripts=SCRIPTS,
        col=config["cells"]["barcode_column"],
        tag=lambda wc: subs.loc[wc.sublib, "cells_tag"],
        subset=("--subset-file " + SUBSET["file"] + " --subset-column " + SUBSET["barcode_column"]) if SUBSET.get("file") else "",
    log:
        "logs/whitelist/{sublib}.log",
    shell:
        r"""
        python {params.scripts}/make_whitelist.py \
            --cells-file {input.cells} \
            --barcode-column {params.col} \
            --sublibrary {wildcards.sublib} \
            --tag '{params.tag}' \
            {params.subset} \
            --bc1 {input.bc1} --bc2 {input.bc2} --bc3 {input.bc3} \
            --out-cells {output.cells} \
            --out-whitelist {output.whitelist} > {log} 2>&1
        """


# --- barcode read layout -----------------------------------------------------
# Scans a sample of fq2 for each round's barcodes at every offset. A few minutes;
# run `source submit.sh layout` and read the JSON before committing to extraction.
rule read_layout:
    input:
        fq1=fastq("fq1"),
        fq2=fastq("fq2"),
        cells=WL + "/cells.tsv",
        **BC_INPUTS,
    output:
        EX + "/read_layout.json",
    params:
        scripts=SCRIPTS,
        n=BC.get("layout_sample_reads", 200000),
        mm=BC.get("max_mismatch", 1),
        umi_start=LAYOUT.get("umi_start", 0),
        umi_len=LAYOUT.get("umi_len", 10),
        bc1=opt(LAYOUT.get("bc1_start")),
        bc2=opt(LAYOUT.get("bc2_start")),
        bc3=opt(LAYOUT.get("bc3_start")),
        overhang=REF["sjdb_overhang"],
    log:
        "logs/extract/{sublib}.layout.log",
    shell:
        r"""
        python {params.scripts}/detect_layout.py \
            --fq1 {input.fq1} --fq2 {input.fq2} \
            --cells {input.cells} \
            --bc1 {input.bc1} --bc2 {input.bc2} --bc3 {input.bc3} \
            --max-mismatch {params.mm} \
            --sample-reads {params.n} \
            --umi-start {params.umi_start} --umi-len {params.umi_len} \
            --bc1-start {params.bc1} --bc2-start {params.bc2} --bc3-start {params.bc3} \
            --sjdb-overhang {params.overhang} \
            --out {output} > {log} 2>&1
        """


# --- extraction --------------------------------------------------------------
# One pass over both FASTQs. Pure Python on the hot loop, so its throughput is
# the pilot's main unknown -- extract_stats.json reports pairs/second.
rule extract_reads:
    input:
        fq1=fastq("fq1"),
        fq2=fastq("fq2"),
        cells=WL + "/cells.tsv",
        layout=EX + "/read_layout.json",
        **BC_INPUTS,
    output:
        r1=EX + "/R1.cdna.fastq.gz",
        r2=EX + "/R2.cb_umi.fastq.gz",
        counts=EX + "/cell_read_counts.tsv",
        stats=EX + "/extract_stats.json",
    params:
        scripts=SCRIPTS,
    threads: nthreads("extract_reads")
    log:
        "logs/extract/{sublib}.extract.log",
    shell:
        r"""
        python {params.scripts}/extract_reads.py \
            --fq1 {input.fq1} --fq2 {input.fq2} \
            --cells {input.cells} --layout {input.layout} \
            --bc1 {input.bc1} --bc2 {input.bc2} --bc3 {input.bc3} \
            --out1 {output.r1} --out2 {output.r2} \
            --counts {output.counts} --stats {output.stats} \
            --threads {threads} > {log} 2>&1
        """


rule validate_extraction:
    input:
        counts=EX + "/cell_read_counts.tsv",
        cells=WL + "/cells.tsv",
        stats=EX + "/extract_stats.json",
    output:
        summary=EX + "/validation/summary.txt",
        cells=EX + "/validation/per_cell.tsv",
        wells=EX + "/validation/per_round1_well.tsv",
    params:
        scripts=SCRIPTS,
        ref_col=config["cells"]["read_count_column"],
        sort_col=config["cells"]["sort_column"],
    log:
        "logs/extract/{sublib}.validate.log",
    shell:
        r"""
        python {params.scripts}/compare_splitpipe.py \
            --counts {input.counts} --cells {input.cells} --stats {input.stats} \
            --read-count-column {params.ref_col} --sort-column {params.sort_col} \
            --out-cells {output.cells} --out-wells {output.wells} \
            --out-summary {output.summary} > {log} 2>&1
        """


# --- STAR index --------------------------------------------------------------
if not REF_BUILT:

    rule star_index:
        input:
            fasta=ancient(REF["fasta"]),
            gtf=ancient(REF["gtf"]),
        output:
            directory(REF_DIR),
        # Built entirely on the node's local disk (qsub -l tscratch, see
        # config/cluster.yaml), then copied to REF_DIR. Suffix-array sorting
        # writes and re-reads ~30 GB of chunks; on /SAN it stalled for 24 h.
        # /scratch0 vanishes with the job, so the copy-back is part of the rule.
        params:
            scratch_root=REF.get("scratch_root", "/scratch0"),
            overhang=REF["sjdb_overhang"],
            ram=int(REF.get("genome_generate_ram_gb", 60) * 1e9),
            extra=REF.get("extra", ""),
        threads: nthreads("star_index")
        log:
            "logs/reference/star_index.log",
        shell:
            r"""
            """ + CHECK_STAR + r"""
            exec > {log} 2>&1
            SCR={params.scratch_root}/${{USER}}/${{JOB_ID:-local.$$}}.star_index
            STAGE={output}.incoming.${{JOB_ID:-local.$$}}
            trap 'rm -rf "$SCR"' EXIT
            rm -rf "$SCR" "$STAGE"
            mkdir -p "$SCR/genome"
            echo "[star_index] $(hostname)  scratch=$SCR"
            df -h {params.scratch_root}

            # STAR needs the GTF as plain text.
            case "{input.gtf}" in
                *.gz) gzip -cd {input.gtf} > "$SCR/genes.gtf" ;;
                *)    cp {input.gtf} "$SCR/genes.gtf" ;;
            esac
            cp {input.fasta} "$SCR/genome.fa"

            # --outTmpDir must not exist beforehand.
            "$STAR_BIN" --runMode genomeGenerate \
                --runThreadN {threads} \
                --genomeDir "$SCR/genome" \
                --genomeFastaFiles "$SCR/genome.fa" \
                --sjdbGTFfile "$SCR/genes.gtf" \
                --sjdbOverhang {params.overhang} \
                --limitGenomeGenerateRAM {params.ram} \
                --outTmpDir "$SCR/_STARtmp" \
                --outFileNamePrefix "$SCR/" \
                {params.extra}

            test -s "$SCR/genome/SA" && test -s "$SCR/genome/genomeParameters.txt"
            # genomeGenerate moves Log.out into --genomeDir when it can.
            if [ -f "$SCR/genome/Log.out" ]; then
                mv "$SCR/genome/Log.out" "$SCR/genome/genomeGenerate.Log.out"
            elif [ -f "$SCR/Log.out" ]; then
                cp "$SCR/Log.out" "$SCR/genome/genomeGenerate.Log.out"
            fi
            # Provenance stamp: this index is shared, so record what built it.
            {{
                echo "built:          $(date -Iseconds)"
                echo "by:             ${{USER:-unknown}}@$(hostname)"
                echo "STAR:           $("$STAR_BIN" --version)"
                echo "fasta:          {input.fasta}"
                echo "gtf:            {input.gtf}"
                echo "sjdbOverhang:   {params.overhang}"
                echo "extra:          {params.extra}"
                echo "workflow:       parse_snrnaseq/starsolo"
            }} > "$SCR/genome/build_provenance.txt"
            du -sh "$SCR/genome"

            # Copy back to a sibling staging dir, check every file arrived at
            # full size, then swap it in, so REF_DIR is never half-written.
            echo "[star_index] copying to $STAGE  $(date)"
            cp -r "$SCR/genome" "$STAGE"
            diff <(cd "$SCR/genome" && find . -type f -printf '%P %s\n' | sort) \
                 <(cd "$STAGE"      && find . -type f -printf '%P %s\n' | sort)
            rm -rf {output}
            mv "$STAGE" {output}
            echo "[star_index] done  $(date)"
            """


# --- STARsolo barcode flags --------------------------------------------------
# R2 is exactly cb + UMI and cb is already corrected, so: simple layout, exact
# whitelist match, no cell calling (every whitelisted barcode is a cell).
SOLO_BC = (
    "--soloType CB_UMI_Simple "
    "--soloCBstart 1 --soloCBlen $CBLEN "
    "--soloUMIstart $((CBLEN + 1)) --soloUMIlen {params.umi_len} "
    "--soloCBwhitelist {input.whitelist} --soloCBmatchWLtype Exact "
    "--soloCellFilter None"
)
CBLEN_SH = "CBLEN=$(head -n1 {input.whitelist} | awk '{{print length($0)}}')"


# --- strand ------------------------------------------------------------------
# Two quick STARsolo runs on the first N reads, Forward vs Reverse. Fails
# rather than guessing if neither strand clearly wins.
rule strand_test:
    input:
        r1=EX + "/R1.cdna.fastq.gz",
        r2=EX + "/R2.cb_umi.fastq.gz",
        whitelist=WL + "/whitelist.txt",
        genome=ancient(REF_DIR),
    output:
        strand=RESULTS + "/strand/{sublib}/strand.txt",
        report=RESULTS + "/strand/{sublib}/strand_test.tsv",
    params:
        scripts=SCRIPTS,
        outdir=RESULTS + "/strand/{sublib}",
        n=STAR.get("strand_test_reads", 2000000),
        umi_len=LAYOUT.get("umi_len", 10),
    threads: nthreads("strand_test")
    log:
        "logs/star/{sublib}.strand.log",
    shell:
        r"""
        """ + CHECK_STAR + CBLEN_SH + r"""
        : > {log}
        for s in Forward Reverse; do
            mkdir -p {params.outdir}/$s
            "$STAR_BIN" --runThreadN {threads} \
                --genomeDir {input.genome} \
                --readFilesIn {input.r1} {input.r2} \
                --readFilesCommand zcat \
                --readMapNumber {params.n} \
                """ + SOLO_BC + r""" \
                --soloStrand $s \
                --soloFeatures Gene GeneFull \
                --outSAMtype None \
                --outFileNamePrefix {params.outdir}/$s/ >> {log} 2>&1
        done
        python {params.scripts}/choose_strand.py \
            --forward {params.outdir}/Forward --reverse {params.outdir}/Reverse \
            --out {output.strand} --report {output.report} >> {log} 2>&1
        """


# --- pass 1: junction discovery ----------------------------------------------
rule star_pass1:
    input:
        r1=EX + "/R1.cdna.fastq.gz",
        genome=ancient(REF_DIR),
    output:
        sj=RESULTS + "/pass1/{sublib}/SJ.out.tab",
        log_final=RESULTS + "/pass1/{sublib}/Log.final.out",
    params:
        prefix=RESULTS + "/pass1/{sublib}/",
        tmp=TMP_ROOT + "/{sublib}.pass1",
        n=STAR.get("pass1_read_number", -1),
        extra=STAR.get("align_extra", ""),
    threads: nthreads("star_pass1")
    log:
        "logs/star/{sublib}.pass1.log",
    shell:
        r"""
        """ + CHECK_STAR + r"""
        rm -rf {params.tmp}
        mkdir -p $(dirname {params.tmp})
        "$STAR_BIN" --runThreadN {threads} \
            --genomeDir {input.genome} \
            --readFilesIn {input.r1} \
            --readFilesCommand zcat \
            --readMapNumber {params.n} \
            --outSAMtype None \
            {params.extra} \
            --outTmpDir {params.tmp} \
            --outFileNamePrefix {params.prefix} > {log} 2>&1
        """


# Pools over every sublibrary in config/sublibraries.tsv -- adding sublibraries
# changes this file and (deliberately) reruns every pass 2.
rule pool_junctions:
    input:
        expand(RESULTS + "/pass1/{sublib}/SJ.out.tab", sublib=SUBLIBS),
    output:
        sjdb=RESULTS + "/pass1/pooled_junctions.sjdb.tsv",
        report=RESULTS + "/pass1/pooled_junctions.report.txt",
    params:
        scripts=SCRIPTS,
        min_unique=STAR.get("pass1_min_unique_reads", 3),
    log:
        "logs/star/pool_junctions.log",
    shell:
        r"""
        python {params.scripts}/pool_junctions.py {input} \
            --min-unique {params.min_unique} \
            --out {output.sjdb} --report {output.report} > {log} 2>&1
        """


# --- pass 2: STARsolo --------------------------------------------------------
_STRAND = str(STAR.get("strand", "auto"))
if _STRAND not in ("auto", "Forward", "Reverse"):
    raise WorkflowError("star.strand must be auto, Forward or Reverse; got " + repr(_STRAND))
TWO_PASS = as_bool(STAR.get("two_pass", True))


def _sjdb_flags(wc, input):
    if not input.sjdb:
        return ""
    return (f"--sjdbFileChrStartEnd {input.sjdb} "
            f"--limitSjdbInsertNsj {STAR.get('limit_sjdb_insert', 2000000)}")


rule star_solo:
    input:
        r1=EX + "/R1.cdna.fastq.gz",
        r2=EX + "/R2.cb_umi.fastq.gz",
        whitelist=WL + "/whitelist.txt",
        genome=ancient(REF_DIR),
        strand=RESULTS + "/strand/{sublib}/strand.txt" if _STRAND == "auto" else [],
        sjdb=RESULTS + "/pass1/pooled_junctions.sjdb.tsv" if TWO_PASS else [],
    output:
        bam=SOLO + "/Aligned.sortedByCoord.out.bam",
        sj=SOLO + "/SJ.out.tab",
        log_final=SOLO + "/Log.final.out",
        solo=directory(SOLO + "/Solo.out"),
    params:
        prefix=SOLO + "/",
        tmp=TMP_ROOT + "/{sublib}.solo",
        fixed_strand="" if _STRAND == "auto" else _STRAND,
        sjdb=_sjdb_flags,
        umi_len=LAYOUT.get("umi_len", 10),
        features=STAR.get("solo_features", "Gene GeneFull SJ"),
        dedup=STAR.get("umi_dedup", "1MM_CR"),
        multimappers=STAR.get("multimappers", "Unique"),
        attrs=STAR.get("sam_attributes", "NH HI AS nM NM MD jM jI CB UB GX GN sM"),
        sort_ram=int(STAR.get("bam_sort_ram_gb", 20) * 1e9),
        extra=STAR.get("align_extra", ""),
    threads: nthreads("star_solo")
    log:
        "logs/star/{sublib}.solo.log",
    shell:
        r"""
        """ + CHECK_STAR + r"""
        if [ -n "{params.fixed_strand}" ]; then
            STRAND={params.fixed_strand}
        else
            STRAND=$(cat {input.strand})
        fi
        """ + CBLEN_SH + r"""
        echo "[star_solo] STAR $("$STAR_BIN" --version) at $STAR_BIN, strand=$STRAND cb_len=$CBLEN" > {log}
        rm -rf {params.tmp}
        mkdir -p $(dirname {params.tmp})

        "$STAR_BIN" --runThreadN {threads} \
            --genomeDir {input.genome} \
            --readFilesIn {input.r1} {input.r2} \
            --readFilesCommand zcat \
            {params.sjdb} \
            """ + SOLO_BC + r""" \
            --soloStrand $STRAND \
            --soloFeatures {params.features} \
            --soloUMIdedup {params.dedup} \
            --soloMultiMappers {params.multimappers} \
            --outSAMtype BAM SortedByCoordinate \
            --outSAMattributes {params.attrs} \
            --limitBAMsortRAM {params.sort_ram} \
            {params.extra} \
            --outTmpDir {params.tmp} \
            --outFileNamePrefix {params.prefix} >> {log} 2>&1
        """


rule index_bam:
    input:
        SOLO + "/Aligned.sortedByCoord.out.bam",
    output:
        SOLO + "/Aligned.sortedByCoord.out.bam.bai",
    threads: nthreads("index_bam")
    shell:
        "samtools index -@ {threads} {input}"


# --- donor x sort BAMs (target: split) ---------------------------------------
# One job for every sublibrary: min_cells then counts a donor x sort group over
# the whole experiment, not one sublibrary at a time. A checkpoint, because the
# group names (and so the merged BAMs) are only known once it has run.
checkpoint group_table:
    input:
        cells=expand(WL + "/cells.tsv", sublib=SUBLIBS),
        annotation=ancient(SPLIT["annotation"]),
    output:
        groups=RESULTS + "/split/groups.tsv",
        summary=RESULTS + "/split/cells_per_group.tsv",
        per_sublib=expand(RESULTS + "/split/{sublib}/cell_groups.tsv", sublib=SUBLIBS),
    params:
        scripts=SCRIPTS,
        outdir=RESULTS + "/split",
        sublibs=" ".join(SUBLIBS),
        donor_col=SPLIT["donor_column"],
        bc_col=SPLIT["barcode_column"],
        cond_col=SPLIT["condition_column"],
        sort_col=config["cells"]["sort_column"],
        min_cells=SPLIT.get("min_cells", 0),
    log:
        "logs/split/group_table.log",
    shell:
        r"""
        python {params.scripts}/group_table.py \
            --cells {input.cells} --sublibraries {params.sublibs} \
            --annotation {input.annotation} \
            --donor-column {params.donor_col} --barcode-column {params.bc_col} \
            --condition-column {params.cond_col} --sort-column {params.sort_col} \
            --min-cells {params.min_cells} \
            --outdir {params.outdir} --groups {output.groups} \
            --summary {output.summary} > {log} 2>&1
        """


rule split_bam:
    input:
        bam=SOLO + "/Aligned.sortedByCoord.out.bam",
        bai=SOLO + "/Aligned.sortedByCoord.out.bam.bai",
        groups=RESULTS + "/split/{sublib}/cell_groups.tsv",
    output:
        bams=directory(RESULTS + "/split/{sublib}/bams"),
        done=touch(RESULTS + "/split/{sublib}/.split.done"),
    threads: nthreads("split_bam")
    log:
        "logs/split/{sublib}.sinto.log",
    shell:
        r"""
        set -euo pipefail
        mkdir -p {output.bams}
        sinto filterbarcodes \
            -b {input.bam} \
            -c {input.groups} \
            --barcodetag CB \
            --outdir {output.bams} \
            -p {threads} > {log} 2>&1
        # sinto works chromosome by chromosome; sort only if a BAM won't index.
        for b in {output.bams}/*.bam; do
            if ! samtools index -@ {threads} "$b" 2>> {log}; then
                samtools sort -@ {threads} -o "$b.sorted" "$b"
                mv "$b.sorted" "$b"
                samtools index -@ {threads} "$b"
            fi
        done
        """


# --- merged donor x sort BAMs ------------------------------------------------
# `samtools merge -r` reads the read group from each file name, so the merged
# BAM records which sublibrary every read came from. That matters here: cell
# barcodes are only unique WITHIN a sublibrary, so CB alone does not identify a
# nucleus in a merged BAM -- use RG + CB (and RG + CB + UB to deduplicate).
rule merge_group_bam:
    input:
        # Directories, so a group missing from a sublibrary is simply not merged.
        expand(RESULTS + "/split/{sublib}/.split.done", sublib=SUBLIBS),
    output:
        bam=RESULTS + "/groups/{group}.bam",
        bai=RESULTS + "/groups/{group}.bam.bai",
    params:
        split=RESULTS + "/split",
        tmp=TMP_ROOT + "/merge.{group}",
        sublibs=" ".join(SUBLIBS),
    threads: nthreads("merge_group_bam")
    log:
        "logs/groups/{group}.merge.log",
    shell:
        r"""
        rm -rf {params.tmp}
        mkdir -p {params.tmp} $(dirname {output.bam})
        n=0
        for s in {params.sublibs}; do
            b={params.split}/$s/bams/{wildcards.group}.bam
            if [ -s "$b" ]; then
                ln -s "$(readlink -f $b)" {params.tmp}/$s.bam
                n=$((n + 1))
            fi
        done
        if [ "$n" -eq 0 ]; then
            echo "no sublibrary has a BAM for group {wildcards.group}" >&2
            exit 1
        fi
        echo "[merge] {wildcards.group}: $n sublibraries" > {log}
        samtools merge -r -f -@ {threads} {output.bam} {params.tmp}/*.bam 2>> {log}
        samtools index -@ {threads} {output.bam} 2>> {log}
        rm -rf {params.tmp}
        """


# --- junction x group count matrix -------------------------------------------
# From STARsolo's per-cell SJ matrices, summed over each group's cells. No BAM
# is read, so this does not depend on the merge above.
rule sj_matrix:
    input:
        solo=expand(SOLO + "/Solo.out", sublib=SUBLIBS),
        groups=expand(RESULTS + "/split/{sublib}/cell_groups.tsv", sublib=SUBLIBS),
    output:
        matrix=RESULTS + "/junctions/sj_counts.by_group.tsv.gz",
        report=RESULTS + "/junctions/sj_counts.report.tsv",
    params:
        scripts=SCRIPTS,
        raw=lambda wc, input: " ".join(d + "/SJ/raw" for d in input.solo),
        sublibs=" ".join(SUBLIBS),
    log:
        "logs/junctions/sj_matrix.log",
    shell:
        r"""
        python {params.scripts}/aggregate_sj.py \
            --solo {params.raw} \
            --groups {input.groups} \
            --sublibraries {params.sublibs} \
            --out {output.matrix} --report {output.report} > {log} 2>&1
        """
